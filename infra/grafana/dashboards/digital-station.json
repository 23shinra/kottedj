{
 "uid": "digital-station",
 "title": "Цифровая станция — сервисы",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Индекс станции (ИИ)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "station_index{world=\"ai\"}"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Индекс станции (FCFS)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "station_index{world=\"baseline\"}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Пересчёт плана p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(planner_solve_seconds_bucket[5m])) by (le))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Задержка событие→UI p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(api_event_to_broadcast_seconds_bucket[1m])) by (le))"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Индекс: ИИ vs FCFS",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "station_index{world=\"ai\"}",
     "legendFormat": "ИИ"
    },
    {
     "refId": "B",
     "expr": "station_index{world=\"baseline\"}",
     "legendFormat": "FCFS"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Время пересчёта (p50/p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(planner_solve_seconds_bucket[1m])) by (le, kind))",
     "legendFormat": "p50 {{kind}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(planner_solve_seconds_bucket[1m])) by (le, kind))",
     "legendFormat": "p95 {{kind}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Входной поток ingest",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ingest_messages_total[30s])) by (result)",
     "legendFormat": "{{result}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Задержка событие → рассылка (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(api_event_to_broadcast_seconds_bucket[30s])) by (le))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(ingest_latency_seconds_bucket[30s])) by (le))",
     "legendFormat": "ingest p95"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Планы по триггерам",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(planner_plans_total[1m])*60) by (trigger, engine)",
     "legendFormat": "{{trigger}} / {{engine}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Связь и нагрузка",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ingest_source_connected",
     "legendFormat": "связь с источником"
    },
    {
     "refId": "B",
     "expr": "sim_stress_active",
     "legendFormat": "стресс"
    },
    {
     "refId": "C",
     "expr": "api_ws_clients",
     "legendFormat": "клиенты UI"
    }
   ]
  }
 ]
}